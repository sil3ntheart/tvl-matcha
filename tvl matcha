local SPECIES_LOWER = {}
for key, col in pairs(SPECIES_COLORS) do SPECIES_LOWER[key:lower()] = col end

local SPECIES_KEYS_SORTED = {}
do
    for key in pairs(SPECIES_LOWER) do SPECIES_KEYS_SORTED[#SPECIES_KEYS_SORTED+1] = key end
    table.sort(SPECIES_KEYS_SORTED, function(a,b)
        if #a ~= #b then return #a > #b end
        return a < b
    end)
end

local function speciesTokens(s)
    local out = {}
    for word in s:gmatch("%a+") do out[#out+1] = word end
    return out
end

local speciesColorCache = {}

local function getColorForSpecies(species)
    if not species or species == "" then return SPECIES_COLORS["?"] end

    if species:sub(1, 9) == "BodyJump:" then
        local origin = species:sub(10)
        local hit = SPECIES_COLORS[origin] or SPECIES_LOWER[origin:lower()]
        return hit or BODYJUMP_UNKNOWN_COLOR
    end

    local cached = speciesColorCache[species]
    if cached then return cached end

    local result = SPECIES_COLORS[species]
    if not result then
        local lower = species:lower():gsub("^%s+",""):gsub("%s+$","")
        result = SPECIES_LOWER[lower]
        if not result then
            for _, key in ipairs(SPECIES_KEYS_SORTED) do
                if lower:find(key, 1, true) then result = SPECIES_LOWER[key]; break end
            end
        end
        if not result then
            for _, tok in ipairs(speciesTokens(lower)) do
                local hit = SPECIES_LOWER[tok]
                if hit then result = hit; break end
            end
        end
    end
    result = result or SPECIES_COLORS["Custom"]
    speciesColorCache[species] = result
    return result
end

