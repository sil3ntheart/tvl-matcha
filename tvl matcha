    DefaultFace = true, _eyes = true, ScreamBlood = true, Face = true,
    BloodFace = true, HeadWeld = true,
}

local function getSpeciesInfo(player, character)
    if not character then return "?", false end

    local cname = nil
    if player then
        local ok, v = pcall(function() return player:GetAttribute("CharacterName") end)
        if ok then cname = v end
    end

    if cname and cname ~= "" then
        if CHARACTER_SPECIES[cname] then
            return CHARACTER_SPECIES[cname], false
        end
        return "Custom", true
    end

    if player and player.Team then
        local tn = player.Team.Name
        if tn and tn ~= "" and tn ~= "Neutral" then return tn, false end
    end

    local head = character:FindFirstChild("Head")
    if head then
        for _, d in ipairs(head:GetChildren()) do
            if d:IsA("Decal") and not IGNORE_FACES[d.Name] and FACE_SPECIES[d.Name] then
                return FACE_SPECIES[d.Name], false
            end
        end
    end

    local faces = character:FindFirstChild("Faces")
    if faces then
        for _, d in ipairs(faces:GetChildren()) do
            if d:IsA("Decal") and FACE_SPECIES[d.Name] then
                return FACE_SPECIES[d.Name], false
            end
        end
    end

    return "?", false
end

local function getCharacterName(player)
    if not player then return nil end
    local ok, cname = pcall(function() return player:GetAttribute("CharacterName") end)
    if ok and cname and cname ~= "" then return cname end
    return nil
end

-- ============================================================
-- RENDER LOOP
-- ============================================================
local function renderLoop()
    if not flags.enabled then return end

    local camera = workspace.CurrentCamera
    if not camera then return end
    local camPos = camera.CFrame.Position
    local now = os.clock()

    for player, obj in pairs(espObjects) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            local worldPos = root.Position
            local dist = (camPos - worldPos).Magnitude

            if dist <= flags.maxDist then
                local screenPos, onScreen = WorldToScreen(worldPos)

                if onScreen and screenPos then
                    local info = infoCache[player]
                    if info and now >= info.lastRefresh then
                        info.lastRefresh = now + INFO_REFRESH
                        info.characterName = getCharacterName(player) or info.characterName
                        local sp, isCustom = getSpeciesInfo(player, char)
                        info.species = sp
                        info.isCustom = isCustom
                    end

                    local size = math.clamp(1500 / math.max(dist, 1), 20, 250)
                    local topY = screenPos.Y - size * 0.5
                    local lineOffset = 0

                    -- Character Name
                    if flags.character and info and info.characterName then
                        obj.character.Color = flags.charColor
                        obj.character.Position = Vector2.new(screenPos.X, topY - 18 + lineOffset)
                        obj.character.Text = info.characterName
                        obj.character.Visible = true
                        lineOffset = lineOffset + 16
                    else
                        obj.character.Visible = false
                    end

                    -- Species / Custom
                    if flags.species and info then
                        if info.isCustom then
                            obj.species.Color = flags.customColor
                        else
                            obj.species.Color = flags.specColor
                        end
                        obj.species.Position = Vector2.new(screenPos.X, topY - 18 + lineOffset)
                        obj.species.Text = "[" .. (info.species or "?") .. "]"
                        obj.species.Visible = true
                        lineOffset = lineOffset + 15
                    else
                        obj.species.Visible = false
                    end

                    -- Username
                    if flags.name then
                        obj.name.Color = flags.nameColor
                        obj.name.Position = Vector2.new(screenPos.X, topY - 18 + lineOffset)
                        obj.name.Text = player.Name
                        obj.name.Visible = true
                        lineOffset = lineOffset + 15
                    else
                        obj.name.Visible = false
                    end

                    -- Distance
                    if flags.distance then
                        obj.dist.Color = flags.distColor
                        obj.dist.Position = Vector2.new(screenPos.X, topY - 18 + lineOffset)
                        obj.dist.Text = tostring(math.floor(dist)) .. " studs"
                        obj.dist.Visible = true
                    else
                        obj.dist.Visible = false
                    end
                else
                    hidePlayer(obj)
                end
            else
                hidePlayer(obj)
            end
        else
            hidePlayer(obj)
        end
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(renderLoop)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait(1 / 60)
            pcall(renderLoop)
        end
    end)
end

