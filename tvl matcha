local function makeWorldESP(getContainer, resolve, f, defaultColor)
    local entries, entryList = {}, {}
    local lastScan = -math.huge
    local cursor = 0

    local function rebuildList()
        local n = 0
        for _, e in pairs(entries) do
            n = n + 1
            entryList[n] = e
        end
        for i = n + 1, #entryList do entryList[i] = nil end
    end

    local function scan(now)
        lastScan = now
        local container = getContainer()
        local seen = {}
        if container then
            local kids = container:GetChildren()
            for i = 1, #kids do
                local m = kids[i]
                seen[m] = true
                local e = entries[m]
                if not e then
                    local label, flag, color = resolve(m.Name)
                    if label and flag then
                        local part = findPart(m)
                        if part then
                            entries[m] = { part=part, label=label, flag=flag,
                                           color=color or defaultColor, draw=nil, key=nil, text=nil }
                        end
                    end
                elseif not e.part or not e.part.Parent then
                    local part = findPart(m)
                    if part then e.part = part else seen[m] = nil end
                end
            end
        end
        for m, e in pairs(entries) do
            if not seen[m] then
                if e.draw then safeRemove(e.draw) end
                entries[m] = nil
            end
        end
        rebuildList()
    end

    local function update(camPos, camLook, batchSize)
        local now = tick()
        if now - lastScan >= SCAN_INTERVAL then scan(now) end

        local count = #entryList
        if count == 0 then return end

        local maxD = f.maxDist
        local maxDSq = maxD * maxD
        local showDist = f.showDist

        for _ = 1, batchSize do
            cursor = cursor + 1
            if cursor > count then cursor = 1 end
            local e = entryList[cursor]
            if e then
                local draw = e.draw
                local show = false
                if e.flag and f[e.flag] and e.part and e.part.Parent then
                    local pos = e.part.Position
                    if pos then
                        local dx = camPos.X - pos.X
                        local dy = camPos.Y - pos.Y
                        local dz = camPos.Z - pos.Z
                        local distSq = dx*dx + dy*dy + dz*dz
                        if distSq <= maxDSq and isInFront(camPos, camLook, pos, 50) then
                            local sp, on = WorldToScreen(pos)
                            if on and sp then
                                if not draw then
                                    draw = newText(13)
                                    if draw then e.draw = draw end
                                end
                                if draw then
                                    setColor(draw, e.color)
                                    local dist = math.sqrt(distSq)
                                    local key = showDist and floor(dist) or -1
                                    if key ~= e.key then
                                        e.key = key
                                        e.text = showDist and (e.label .. " [" .. key .. "]") or e.label
                                    end
                                    setText(draw, e.text)
                                    setPos(draw, sp.X, sp.Y)
                                    setVisible(draw, true)
                                    show = true
                                end
                            end
                        end
                    end
                end
                if not show and draw then setVisible(draw, false) end
            end
        end
    end

    local function hide()
        for _, e in pairs(entries) do
            if e.draw then setVisible(e.draw, false) end
        end
    end

    local function reset()
        lastScan = -math.huge
        for _, e in pairs(entries) do
            if e.draw then safeRemove(e.draw) end
        end
        entries = {}
        entryList = {}
    end

    return update, hide, reset
end

