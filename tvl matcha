-- ===== render loop =====
local worldESPs = {
    { name="plants",  f=plantFlags,   update=updatePlants,   reset=resetPlants,   guard=-math.huge },
    { name="gems",    f=gemFlags,     update=updateGems,     reset=resetGems,     guard=-math.huge },
    { name="pumpkin", f=pumpkinFlags, update=updatePumpkins, reset=resetPumpkins, guard=-math.huge },
    { name="books",   f=bookFlags,    update=updateBooks,    reset=resetBooks,    guard=-math.huge },
    { name="maze",    f=mazeFlags,    update=updateMaze,     reset=resetMaze,     guard=-math.huge },
    { name="souls",   f=soulFlags,    update=updateSouls,    reset=resetSouls,    guard=-math.huge },
    { name="crows",   f=crowFlags,    update=updateCrows,    reset=resetCrows,    guard=-math.huge },
}

local lastPlayerErr = -math.huge

local function renderLoop()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local camCF = camera.CFrame
    local camPos = camCF.Position
    local camLook = camCF.LookVector
    local now = tick()

    if flags.enabled then
        local ok, err = pcall(updatePlayers, camPos, camLook, now)
        if not ok and now - lastPlayerErr > 5 then
            lastPlayerErr = now
            warn("[tvl] player ESP error:", err)
        end
    end

    for i = 1, #worldESPs do
        local w = worldESPs[i]
        if w.f.enabled then
            local ok, err = pcall(w.update, camPos, camLook, now)
            if not ok and now - w.guard > 5 then
                w.guard = now
                warn("[tvl] " .. w.name .. " ESP error:", err)
                w.reset()
            end
        end
    end
end

local renderOK = pcall(function() RunService.RenderStepped:Connect(renderLoop) end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait(1/60)
            pcall(renderLoop)
        end
    end)
end

