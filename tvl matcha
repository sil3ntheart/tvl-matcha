-- FIX: gsub returns 2 values; parentheses force a single string return
local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

local function getCharacterName(player)
    if not player then return nil end
    local c = player:GetAttribute("CharacterName")
    if type(c) == "string" and c ~= "" then return trim(c) end
    local d = player:GetAttribute("DisplayName")
    if type(d) == "string" and d ~= "" then return trim(d) end
    return nil
end

local function getSpecies(player, character, preName)
    if not character then return "?" end

    local cname = preName or getCharacterName(player)

    if cname and cname ~= "" then
        local ov = NAME_OVERRIDES[cname]
        if ov then return ov end
    end

    if player:GetAttribute("AstralProjection") then
        if cname and cname ~= "" then
            if SPECIAL_WITCHES[cname] then return SPECIAL_WITCHES[cname] end
            if CHARACTER_SPECIES[cname] then return CHARACTER_SPECIES[cname] end
        end
    end

    if player:GetAttribute("BodyJumped") then
        local origin = player:GetAttribute("BodyJumpOrigin")
        if type(origin) == "string" and origin ~= "" then
            if SPECIAL_WITCHES[origin] then return SPECIAL_WITCHES[origin] end
            if CHARACTER_SPECIES[origin] then return CHARACTER_SPECIES[origin] end
            return "BodyJump:" .. origin
        end
    end

    local specType = character:GetAttribute("SpecieType")

    if type(specType) == "string" and specType ~= "" then
        if specType == "Hunter" then return "Mortal" end
        if specType == "Witch" then
            if character:GetAttribute("Siphoner") then return "Siphoner" end
            if cname and SPECIAL_WITCHES[cname] then return SPECIAL_WITCHES[cname] end
        end
        return specType
    end

    if cname and cname ~= "" then
        if SPECIAL_WITCHES[cname] then return SPECIAL_WITCHES[cname] end
        return CHARACTER_SPECIES[cname] or "Custom"
    end
    return "?"
end

-- reuses scratch tables instead of allocating 3 tables per player per scan
local itemFound, itemSeen = {}, {}

local function scanItems(container, n)
    if not container then return n end
    local kids = container:GetChildren()
    for i = 1, #kids do
        local display = IMPORTANT_ITEMS[kids[i].Name]
        if display and not itemSeen[display] then
            itemSeen[display] = true
            n = n + 1
            itemFound[n] = display
        end
    end
    return n
end

local function getPlayerItems(player)
    for k in pairs(itemSeen) do itemSeen[k] = nil end
    local n = scanItems(player:FindFirstChild("Backpack"), 0)
    n = scanItems(player.Character, n)
    for i = n + 1, #itemFound do itemFound[i] = nil end
    if n == 0 then return "" end
    if n > 1 then table.sort(itemFound) end
    return "[" .. table.concat(itemFound, "] [") .. "]"
end

-- ===== cached drawing setters =====
local COLORS = { name=Color3.fromRGB(255,255,255), distance=Color3.fromRGB(120,255,180) }
local ITEM_COLOR = Color3.fromRGB(255,255,255)
local weak = { __mode = "k" }
local visCache, textCache, colorCache = setmetatable({},weak), setmetatable({},weak), setmetatable({},weak)
local posX, posY = setmetatable({},weak), setmetatable({},weak)

local function setVisible(d,v) if visCache[d]~=v then visCache[d]=v; d.Visible=v end end
local function setText(d,t) if textCache[d]~=t then textCache[d]=t; d.Text=t end end
local function setColor(d,c) if colorCache[d]~=c then colorCache[d]=c; d.Color=c end end
local function setPos(d,x,y)
    x=floor(x+0.5); y=floor(y+0.5)
    if posX[d]~=x or posY[d]~=y then posX[d]=x; posY[d]=y; d.Position=Vector2.new(x,y) end
end
local function newText(size)
    local t = safeNewText(size)
    if t then visCache[t] = false end
    return t
end
local function removeAll(tbl)
    if not tbl then return end
    for _,d in pairs(tbl) do if d then safeRemove(d) end end
end

local function isInFront(camPos, camLook, worldPos, slack)
    local dx = worldPos.X - camPos.X
    local dy = worldPos.Y - camPos.Y
    local dz = worldPos.Z - camPos.Z
    return (dx*camLook.X + dy*camLook.Y + dz*camLook.Z) > -slack
end

-- ===== player ESP =====
local espObjects, infoCache = {}, {}
local playerList = {}
local INFO_REFRESH = 0.5
local ITEM_REFRESH = 1.0

local function rebuildPlayerList()
    local n = 0
    for p in pairs(espObjects) do
        n = n + 1
        playerList[n] = p
    end
    for i = n + 1, #playerList do playerList[i] = nil end
end

local function createESP(player)
    if player == LocalPlayer or espObjects[player] then return end
    local obj = {
        name=newText(14),
        character=newText(14),
        items=newText(11),
        dist=newText(12),
    }
    if not obj.name or not obj.character or not obj.items or not obj.dist then
        if obj.name then safeRemove(obj.name) end
        if obj.character then safeRemove(obj.character) end
        if obj.items then safeRemove(obj.items) end
        if obj.dist then safeRemove(obj.dist) end
        return
    end
    setColor(obj.name, COLORS.name)
    setColor(obj.dist, COLORS.distance)
    setColor(obj.items, ITEM_COLOR)
    espObjects[player] = obj
    infoCache[player] = {
        username=player.Name, characterName=nil, species="?", color=SPECIES_COLORS["?"],
        display="[?]", itemsText="", char=nil, root=nil, hum=nil,
        lastDist=-1, distText="", lastRefresh=0, lastItemRefresh=0,
    }
    rebuildPlayerList()
end

local function hidePlayer(obj)
    if not obj then return end
    for _,d in pairs(obj) do if d then setVisible(d, false) end end
end
local function hideAllESP() for _,obj in pairs(espObjects) do hidePlayer(obj) end end
local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player]=nil
    infoCache[player]=nil
    rebuildPlayerList()
end

pcall(function() for _,p in ipairs(Players:GetPlayers()) do createESP(p) end end)
pcall(function() if Players.PlayerAdded then Players.PlayerAdded:Connect(createESP) end end)
pcall(function() if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end end)

