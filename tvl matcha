local BASE_CLASSES = {
    Part=true, MeshPart=true, UnionOperation=true, NegateOperation=true,
    WedgePart=true, CornerWedgePart=true, TrussPart=true, SpawnLocation=true,
    Seat=true, VehicleSeat=true, Platform=true,
}

local function findPart(model)
    if not model or not model.Parent then return nil end
    if BASE_CLASSES[model.ClassName] then return model end
    local ok, part = pcall(model.FindFirstChildWhichIsA, model, "BasePart", true)
    if ok and part then return part end
    return nil
end

local function getInteractableFolder(name)
    return function()
        local i = workspace:FindFirstChild("Interactables")
        return i and i:FindFirstChild(name)
    end
end

local function makeESP(f, textSize, scanInterval, scanFn)
    local entries = {}
    local nearList, nearCount = {}, 0
    local seen = {}
    local lastScan, lastNear = -math.huge, -math.huge
    local cursor = 0

    local function add(key, label, color, flag, partOverride)
        local e = entries[key]
        if e then
            local p = e.part
            if not p or not p.Parent then
                p = partOverride or findPart(key)
                if not p then return end
                e.part = p
            end
            seen[key] = true
            return
        end
        local p = partOverride or findPart(key)
        if not p then return end
        entries[key] = { part=p, label=label, color=color, flag=flag,
                         draw=nil, key=nil, text=nil, dead=false }
        seen[key] = true
    end

    local function scan(now)
        lastScan = now
        for k in pairs(seen) do seen[k] = nil end
        scanFn(add)
        for key, e in pairs(entries) do
            if not seen[key] then
                e.dead = true
                if e.draw then safeRemove(e.draw); e.draw = nil end
                entries[key] = nil
            end
        end
        lastNear = -math.huge -- force near list rebuild after a scan
    end

    local function rebuildNear(camPos)
        local lim = f.maxDist * 1.2 + 150 -- margin so moving targets don't pop in late
        local limSq = lim * lim
        local n = 0
        for _, e in pairs(entries) do
            local keep = false
            if f[e.flag] then
                local part = e.part
                if part and part.Parent then
                    local pos = part.Position
                    if pos then
                        local dx = camPos.X - pos.X
                        local dy = camPos.Y - pos.Y
                        local dz = camPos.Z - pos.Z
                        if dx*dx + dy*dy + dz*dz <= limSq then keep = true end
                    end
                end
            end
            if keep then
                n = n + 1
                nearList[n] = e
            elseif e.draw then
                setVisible(e.draw, false)
            end
        end
        for i = n + 1, #nearList do nearList[i] = nil end
        nearCount = n
        if cursor > n then cursor = 0 end
    end

    local function update(camPos, camLook, now)
        if now - lastScan >= scanInterval then scan(now) end
        if now - lastNear >= NEAR_INTERVAL then
            rebuildNear(camPos)
            lastNear = now
        end

        local count = nearCount
        if count == 0 then return end

        local maxDSq = f.maxDist * f.maxDist
        local showDist = f.showDist
        local steps = count < WORLD_MAX_PER_FRAME and count or WORLD_MAX_PER_FRAME

        for _ = 1, steps do
            cursor = cursor + 1
            if cursor > count then cursor = 1 end
            local e = nearList[cursor]
            if e and not e.dead then
                local draw = e.draw
                local show = false
                local part = e.part
                if part and part.Parent then
                    local pos = part.Position
                    if pos then
                        local dx = camPos.X - pos.X
                        local dy = camPos.Y - pos.Y
                        local dz = camPos.Z - pos.Z
                        local distSq = dx*dx + dy*dy + dz*dz
                        if distSq <= maxDSq and isInFront(camPos, camLook, pos, FRONT_SLACK) then
                            local sp, on = WorldToScreen(pos)
                            if on and sp then
                                if not draw then
                                    draw = newText(textSize)
                                    e.draw = draw
                                    if draw then setColor(draw, e.color) end
                                end
                                if draw then
                                    local key = showDist and floor(sqrt(distSq)) or -1
                                    if key ~= e.key then
                                        e.key = key
                                        e.text = showDist and (e.label .. " [" .. key .. "]") or e.label
                                    end
                                    setText(draw, e.text)
                                    setPos(draw, sp.X, sp.Y)
                                    setVisible(draw, true)
                                    show = true
                                end
                            end
                        end
                    end
                end
                if not show and draw then setVisible(draw, false) end
            end
        end
    end

    -- also used when toggled off: frees the Drawing objects instead of keeping them alive hidden
    local function reset()
        lastScan, lastNear = -math.huge, -math.huge
        for _, e in pairs(entries) do
            e.dead = true
            if e.draw then safeRemove(e.draw) end
        end
        entries = {}
        nearList = {}
        nearCount = 0
        cursor = 0
    end

    return update, reset
end

