-- ============================================================
-- CURE ESP (state lookup throttled to 4x/sec)
-- ============================================================
local CURE_GREEN = Color3.fromRGB( 80, 255, 100)
local CURE_RED   = Color3.fromRGB(255,  70,  70)

local function getCureState()
    local I = workspace:FindFirstChild("Interactables")
    if I then
        local ST = I:FindFirstChild("SilasTomb")
        if ST then
            local CB = ST:FindFirstChild("CureBox")
            if CB then
                local TheCure = CB:FindFirstChild("TheCure")
                if TheCure then
                    local ok, pos = pcall(function() return TheCure.Position end)
                    if ok and pos and typeof(pos) == "Vector3" then
                        return "ground", pos, nil
                    end
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local bp = p:FindFirstChild("Backpack")
            local char = p.Character
            local hasCure = (bp and bp:FindFirstChild("TheCure"))
                or (char and char:FindFirstChild("TheCure"))

            if hasCure then
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local ok, pos = pcall(function() return root.Position end)
                    if ok and pos and typeof(pos) == "Vector3" then
                        return "taken", pos, p
                    end
                end
            end
        end
    end

    return nil, nil, nil
end

local function hideAllCure()
    for _, d in pairs(cureObjects) do
        if d then setVisible(d, false) end
    end
end

local cureState, curePos, cureOwner = nil, nil, nil
local cureKey, cureLabel, cureColor = nil, nil, nil
local lastCureCheck = 0
local CURE_INTERVAL = 0.25

local function updateCure(now)
    if now - lastCureCheck >= CURE_INTERVAL then
        lastCureCheck = now
        cureState, curePos, cureOwner = getCureState()

        if cureState == "ground" and not lastCureUp and cureFlags.notify then
            pcall(function() notify("Cure spawned!", "^.^meg tvl", 4) end)
        end
        lastCureUp = (cureState == "ground")

        if cureState == "ground" then
            cureKey, cureLabel, cureColor = "ground", "Cure", CURE_GREEN
        elseif cureState == "taken" then
            cureKey   = "taken_" .. tostring(cureOwner)
            cureLabel = "Cure (" .. cureOwner.Name .. ")"
            cureColor = CURE_RED
        else
            cureKey = nil
        end
    end

    if not cureState or not curePos or not cureKey then
        hideAllCure()
        return
    end

    -- a carried cure follows the holder's live position
    local pos = curePos
    if cureState == "taken" and cureOwner then
        local c = cureOwner.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root then pos = root.Position end
    end

    local draw = cureObjects[cureKey]
    if not draw then
        draw = newText(15)
        cureObjects[cureKey] = draw
    end
    setColor(draw, cureColor)
    setText(draw, cureLabel)

    local sp, on = WorldToScreen(pos)
    if on and sp then
        setPos(draw, sp.X, sp.Y - 30)
        setVisible(draw, true)
    else
        setVisible(draw, false)
    end

    for k, d in pairs(cureObjects) do
        if k ~= cureKey then setVisible(d, false) end
    end
end

-- ============================================================
-- RENDER LOOP
-- ============================================================
local function renderLoop()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local camPos = camera.CFrame.Position
    local now = tick()

    if flags.enabled then
        local ok = pcall(updatePlayers, camPos, now)
        if not ok then hideAllESP() end
    end

    if plantFlags.enabled then
        local ok = pcall(updatePlants, camPos)
        if not ok then resetPlants() end -- stale model: force a rescan
    end

    if gemFlags.enabled then
        local ok = pcall(updateGems, camPos)
        if not ok then resetGems() end
    end

    if cureFlags.enabled then
        pcall(updateCure, now)
    end
end

local renderOK = pcall(function()
    RunService.RenderStepped:Connect(renderLoop)
end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait(1 / 60)
            pcall(renderLoop)
        end
    end)
end

