-- lowercase lookup table built once
local SPECIES_LOWER = {}
for key, col in pairs(SPECIES_COLORS) do
    SPECIES_LOWER[key:lower()] = col
end

-- result cache so the fuzzy lookup runs once per distinct species string
local speciesColorCache = {}

local function getColorForSpecies(species)
    if not species or species == "" then
        return SPECIES_COLORS["?"]
    end

    local cached = speciesColorCache[species]
    if cached then return cached end

    local result = SPECIES_COLORS[species]
    if not result then
        local lower = species:lower():gsub("^%s+", ""):gsub("%s+$", "")
        result = SPECIES_LOWER[lower]
        if not result then
            for key, col in pairs(SPECIES_LOWER) do
                if lower:find(key, 1, true) then result = col; break end
            end
        end
    end
    result = result or SPECIES_COLORS["Custom"]
    speciesColorCache[species] = result
    return result
end

