-- PUMPKIN ESP (Limited Hollowen)
local PUMPKIN_COLOR = Color3.fromRGB(255, 140, 30)
local PUMPKIN_LABEL = "Pumpkin"
local PUMPKIN_SCAN_INTERVAL = 0.5

local DECORATIVE_PARENTS = {
    HalloweenDecorations = true, HalloweenShop = true, PumpkinPatch = true,
    PumpkinShop = true, MaskShop = true, PumpkinsHay = true, PumpkinBundle = true,
    CharacterSelectionArea = true, Houses = true, PurchasableHouses = true,
    TrickOrTreatDoor = true, Effects = true,
}

local function isUnderDecorative(obj)
    local p = obj.Parent
    local depth = 0
    while p and depth < 6 do
        if DECORATIVE_PARENTS[p.Name] then return true end
        p = p.Parent
        depth = depth + 1
    end
    return false
end

local function isPickupPumpkin(obj)
    if not obj or not obj.Parent then return false end
    if not (obj:IsA("Model") or obj:IsA("MeshPart") or obj:IsA("Part")) then return false end
    local n = obj.Name
    if not (n == "Pumpkin" or n == "Candy" or n:lower():find("pumpkin", 1, true)) then return false end
    if isUnderDecorative(obj) then return false end
    local top = obj
    while top.Parent and top.Parent ~= workspace do top = top.Parent end
    if top.Parent ~= workspace then return false end
    return true
end

local pumpkinDraws = {}
local pumpkinList = {}
local lastPumpkinScan = -math.huge
local pumpkinCursor = 0

local function getPumpkinPos(obj)
    local ok, p = pcall(function() return obj.Position end)
    if ok and p then return p end
    if obj:IsA("Model") then
        local ok2, prim = pcall(function() return obj.PrimaryPart end)
        if ok2 and prim then
            local ok3, pp = pcall(function() return prim.Position end)
            if ok3 and pp then return pp end
        end
        local part = findPart(obj)
        if part then
            local ok4, pp = pcall(function() return part.Position end)
            if ok4 and pp then return pp end
        end
    end
    return nil
end

local function scanPumpkins(now)
    lastPumpkinScan = now
    local seen = {}
    local function consider(obj)
        if seen[obj] then return end
        if not isPickupPumpkin(obj) then return end
        seen[obj] = true
        if not pumpkinDraws[obj] then
            local d = newText(14)
            if d then
                setColor(d, PUMPKIN_COLOR)
                pumpkinDraws[obj] = { draw=d, key=nil, text=nil }
            end
        end
    end
    local ok, kids = pcall(function() return workspace:GetChildren() end)
    if ok and kids then
        for i = 1, #kids do consider(kids[i]) end
    end
    local q = workspace:FindFirstChild("Interactables")
    if q then
        local quests = q:FindFirstChild("Quests")
        if quests then
            local qk = quests:GetChildren()
            for i = 1, #qk do
                if not DECORATIVE_PARENTS[qk[i].Name] then consider(qk[i]) end
            end
        end
    end
    local qd = workspace:FindFirstChild("QuestDestination")
    if qd then
        local qdk = qd:GetChildren()
        for i = 1, #qdk do
            if not DECORATIVE_PARENTS[qdk[i].Name] then consider(qdk[i]) end
        end
    end
    for obj, e in pairs(pumpkinDraws) do
        if not seen[obj] or not obj.Parent then
            if e.draw then safeRemove(e.draw) end
            pumpkinDraws[obj] = nil
        end
    end
    local n = 0
    for obj in pairs(pumpkinDraws) do n = n + 1; pumpkinList[n] = obj end
    for i = n + 1, #pumpkinList do pumpkinList[i] = nil end
end

local function hideAllPumpkins()
    for _, e in pairs(pumpkinDraws) do
        if e.draw then setVisible(e.draw, false) end
    end
end

local function resetPumpkins()
    lastPumpkinScan = -math.huge
    for _, e in pairs(pumpkinDraws) do
        if e.draw then safeRemove(e.draw) end
    end
    pumpkinDraws = {}
    pumpkinList = {}
end

local function updatePumpkins(camPos, camLook, now, batchSize)
    if now - lastPumpkinScan >= PUMPKIN_SCAN_INTERVAL then scanPumpkins(now) end
    local count = #pumpkinList
    if count == 0 then return end
    local maxD = pumpkinFlags.maxDist
    local maxDSq = maxD * maxD
    local showDist = pumpkinFlags.showDist
    for _ = 1, batchSize do
        pumpkinCursor = pumpkinCursor + 1
        if pumpkinCursor > count then pumpkinCursor = 1 end
        local obj = pumpkinList[pumpkinCursor]
        if obj then
            local e = pumpkinDraws[obj]
            if e and e.draw then
                local pos = getPumpkinPos(obj)
                local show = false
                if pos and obj.Parent then
                    local dx = camPos.X - pos.X
                    local dy = camPos.Y - pos.Y
                    local dz = camPos.Z - pos.Z
                    local distSq = dx*dx + dy*dy + dz*dz
                    if distSq <= maxDSq and isInFront(camPos, camLook, pos, 50) then
                        local sp, on = WorldToScreen(pos)
                        if on and sp then
                            local dist = math.sqrt(distSq)
                            local key = showDist and floor(dist) or -1
                            if key ~= e.key then
                                e.key = key
                                e.text = showDist and (PUMPKIN_LABEL .. " [" .. key .. "]") or PUMPKIN_LABEL
                            end
                            setText(e.draw, e.text)
                            setPos(e.draw, sp.X, sp.Y)
                            setVisible(e.draw, true)
                            show = true
                        end
                    end
                end
                if not show then setVisible(e.draw, false) end
            end
        end
    end
end
