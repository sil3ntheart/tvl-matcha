-- ============================================================
-- CONFIG
-- ============================================================
local CONFIG_FILE = "megs_tvl_config.json"
local function colorToStr(c)
    return string.format("%d,%d,%d",
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function strToColor(s)
    local r, g, b = s:match("^(%d+),(%d+),(%d+)$")
    if not r then return nil end
    return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
end
local function saveConfig()
    local lines = {}
    for k, v in pairs(flags) do
        if k ~= "enabled" then
            if typeof(v) == "Color3" then
                lines[#lines+1] = k .. "=C:" .. colorToStr(v)
            elseif type(v) == "boolean" then
                lines[#lines+1] = k .. "=B:" .. tostring(v)
            elseif type(v) == "number" then
                lines[#lines+1] = k .. "=N:" .. tostring(v)
            end
        end
    end
    pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
end
local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([CBN]):(.+)$")
        if key and tag and val then
            if tag == "C" then
                local c = strToColor(val); if c then flags[key] = c end
            elseif tag == "B" then
                flags[key] = (val == "true")
            elseif tag == "N" then
                flags[key] = tonumber(val) or flags[key]
            end
        end
    end
end
loadConfig()

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

-- ============================================================
-- DRAWING
-- ============================================================
local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Visible = false
    return t
end
local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end
local function createESP(player)
    if player == LocalPlayer or espObjects[player] then return end
    espObjects[player] = {
        name      = newText(14),
        character = newText(14),
        species   = newText(13),
        dist      = newText(12),
    }
    infoCache[player] = {
        characterName = nil,
        species       = "?",
        isCustom      = false,
        lastRefresh   = 0,
    }
end
local function hidePlayer(obj)
    if not obj then return end
    for _, drawing in pairs(obj) do
        if drawing then drawing.Visible = false end
    end
end
local function hideAllESP()
    for _, obj in pairs(espObjects) do hidePlayer(obj) end
end
local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player] = nil
    infoCache[player] = nil
end

pcall(function()
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
end)
pcall(function()
    if Players.PlayerAdded then Players.PlayerAdded:Connect(createESP) end
end)
pcall(function()
    if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end
end)

task.spawn(function()
    while true do
        task.wait(1)
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if not espObjects[p] and p ~= LocalPlayer then createESP(p) end
            end
            for p in pairs(espObjects) do
                if not seen[p] then removeESP(p) end
            end
        end
    end
end)

