local plantFolder = getInteractableFolder("Plants")
local updatePlants, resetPlants = makeESP(plantFlags, 13, 2, function(add)
    local c = plantFolder()
    if not c then return end
    local kids = c:GetChildren()
    for i = 1, #kids do
        local m = kids[i]
        local d = PLANT_MODELS[m.Name]
        if d then add(m, d, PLANT_COLORS[d] or PLANT_TEXT_COLOR, d) end
    end
end)

