local function refreshInfo(player, info, now)
    info.lastRefresh = now + INFO_REFRESH + math.random()*0.15
    local char = player.Character
    info.char = char
    if char then
        info.root = char:FindFirstChild("HumanoidRootPart")
        info.hum = char:FindFirstChildOfClass("Humanoid")
    else
        info.root, info.hum = nil, nil
    end

    local isBodyJumped = player:GetAttribute("BodyJumped")
    local bodyJumpOrigin = nil
    if isBodyJumped then
        local origin = player:GetAttribute("BodyJumpOrigin")
        if type(origin) == "string" and origin ~= "" then bodyJumpOrigin = origin end
    end
    local resolvedName = bodyJumpOrigin or getCharacterName(player)
    info.characterName = resolvedName or info.characterName

    if flags.character then
        local species = getSpecies(player, char, resolvedName)
        info.species = species
        info.color = getColorForSpecies(species)
    end

    local displayName = info.characterName
    if not displayName or displayName == "" then displayName = "[?]" end
    displayName = DISPLAY_ALIASES[displayName] or displayName
    if flags.character and TRANSITIONING[info.species] then
        displayName = displayName .. " (transitioning)"
    end

    if player:GetAttribute("AstralProjection") then
        displayName = displayName .. " (astral)"
    end

    info.display = displayName
end

local function refreshItems(player, info, now)
    info.lastItemRefresh = now + ITEM_REFRESH
    if not flags.inventory then
        info.itemsText = ""
        return
    end
    info.itemsText = getPlayerItems(player)
end

local function isInFront(camPos, camLook, worldPos, slack)
    local dx = worldPos.X - camPos.X
    local dy = worldPos.Y - camPos.Y
    local dz = worldPos.Z - camPos.Z
    return (dx*camLook.X + dy*camLook.Y + dz*camLook.Z) > -slack
end

local playerCursor = 0

local function updatePlayersBatch(camPos, camLook, now, batchSize)
    local count = #playerList
    if count == 0 then return end

    local maxD, showChar, showName, showDist, showInv =
        flags.maxDist, flags.character, flags.name, flags.distance, flags.inventory

    local maxDSq = maxD * maxD

    for _ = 1, batchSize do
        playerCursor = playerCursor + 1
        if playerCursor > count then playerCursor = 1 end
        local player = playerList[playerCursor]
        if player then
            local obj = espObjects[player]
            local info = infoCache[player]
            if obj and info then
                if now >= info.lastRefresh then refreshInfo(player, info, now) end
                if now >= info.lastItemRefresh then refreshItems(player, info, now) end

                local drew = false

                local root, hum = info.root, info.hum
                if root and hum and root.Parent and hum.Health > 0 then
                    local worldPos = root.Position
                    if worldPos then
                        local dx = camPos.X - worldPos.X
                        local dy = camPos.Y - worldPos.Y
                        local dz = camPos.Z - worldPos.Z
                        local distSq = dx*dx + dy*dy + dz*dz

                        if distSq <= maxDSq and isInFront(camPos, camLook, worldPos, 20) then
                            local sp, onScreen = WorldToScreen(worldPos)
                            if onScreen and sp then
                                drew = true

                                local dist = math.sqrt(distSq)
                                local x = sp.X
                                local y = sp.Y - clamp(1500/max(dist,1), 20, 250)*0.5 - 18

                                if showChar and obj.character then
                                    setColor(obj.character, info.color)
                                    setText(obj.character, info.display)
                                    setPos(obj.character, x, y)
                                    setVisible(obj.character, true)
                                    y = y + 16
                                elseif obj.character then
                                    setVisible(obj.character, false)
                                end

                                if showName and obj.name then
                                    setText(obj.name, info.username)
                                    setPos(obj.name, x, y)
                                    setVisible(obj.name, true)
                                    y = y + 15
                                elseif obj.name then
                                    setVisible(obj.name, false)
                                end

                                if obj.items then
                                    if showInv and info.itemsText ~= "" then
                                        setText(obj.items, info.itemsText)
                                        setPos(obj.items, x, y)
                                        setVisible(obj.items, true)
                                        y = y + 13
                                    else
                                        setVisible(obj.items, false)
                                    end
                                end

                                if showDist and obj.dist then
                                    local fd = floor(dist)
                                    if math.abs(fd - info.lastDist) >= DIST_TEXT_MIN_DELTA then
                                        info.lastDist = fd
                                        info.distText = fd .. " studs"
                                    end
                                    setText(obj.dist, info.distText)
                                    setPos(obj.dist, x, y)
                                    setVisible(obj.dist, true)
                                elseif obj.dist then
                                    setVisible(obj.dist, false)
                                end
                            end
                        end
                    end
                end

                if not drew then
                    hidePlayer(obj)
                end
            end
        end
    end
end

