-- ===== drawing helpers =====
local DRAW_COUNT = 0
local DRAW_CAP = 1800
local removedDraws = setmetatable({}, { __mode = "k" })

local function safeNewText(size)
    if DRAW_COUNT >= DRAW_CAP then return nil end
    local ok, t = pcall(Drawing.new, "Text")
    if not ok or not t then return nil end
    DRAW_COUNT = DRAW_COUNT + 1
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Font = Drawing.Fonts.SystemBold -- FONT CHANGED HERE
    t.Visible = false
    return t
end

local function safeRemove(d)
    if not d or removedDraws[d] then return end -- guard against double-remove skewing DRAW_COUNT
    removedDraws[d] = true
    pcall(function() d:Remove() end)
    DRAW_COUNT = DRAW_COUNT - 1
    if DRAW_COUNT < 0 then DRAW_COUNT = 0 end
end

