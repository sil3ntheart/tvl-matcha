-- ===== BOOK ESP (Winifred Sanderson quest) =====
local BOOK_COLOR = Color3.fromRGB(255, 215, 0)
local updateBooks, resetBooks = makeESP(bookFlags, 14, 0.5, function(add)
    local i = workspace:FindFirstChild("Interactables")
    local quests = i and i:FindFirstChild("Quests")
    local winifred = quests and quests:FindFirstChild("WinifredSanderson_26")
    if not winifred then return end

    local physicalBook = workspace:FindFirstChild("Book")
    local bookPos = nil
    if physicalBook and physicalBook:IsA("BasePart") then bookPos = physicalBook.Position end

    local kids = winifred:GetChildren()
    for k = 1, #kids do
        local sp = kids[k]
        if sp:IsA("BasePart") then
            local active = false
            if bookPos and (sp.Position - bookPos).Magnitude < 10 then
                active = true
            else
                local sub = sp:GetChildren()
                for j = 1, #sub do
                    if sub[j]:IsA("BasePart") then active = true; break end
                end
            end
            if active then add(sp, "Book", BOOK_COLOR, "enabled", sp) end
        end
    end
end)

-- ===== CORN MAZE ESP =====
local MAZE_COLOR = Color3.fromRGB(255, 50, 50)
local EXIT_COLOR = Color3.fromRGB(50, 255, 50)
local updateMaze, resetMaze = makeESP(mazeFlags, 14, 0.5, function(add)
    -- moving KillPart hazards (Workspace.[Number].KillPart)
    -- cheap byte check first so IsA/FindFirstChild only run on numeric names
    local kids = workspace:GetChildren()
    for i = 1, #kids do
        local obj = kids[i]
        local name = obj.Name
        local b = name:byte(1)
        if b and b >= 48 and b <= 57 and name:find("^%d+$") and obj:IsA("Model") then
            local killPart = obj:FindFirstChild("KillPart")
            if killPart then add(killPart, "Beast", MAZE_COLOR, "enabled") end
        end
    end

    local cornMaze = workspace:FindFirstChild("CornMaze")
    if cornMaze then
        local finished = cornMaze:FindFirstChild("Finished")
        if finished then add(finished, "Exit", EXIT_COLOR, "enabled") end
    end
end)

-- ===== PUMPKIN ESP (Limited Hollowen) =====
local PUMPKIN_COLOR = Color3.fromRGB(255, 140, 30)
local PUMPKIN_LABEL = "Pumpkin"

local DECORATIVE_PARENTS = {
    HalloweenDecorations = true, HalloweenShop = true, PumpkinPatch = true,
    PumpkinShop = true, MaskShop = true, PumpkinsHay = true, PumpkinBundle = true,
    CharacterSelectionArea = true, Houses = true, PurchasableHouses = true,
    TrickOrTreatDoor = true, Effects = true,
}
local PUMPKIN_CLASSES = { Model=true, MeshPart=true, Part=true }

local function isUnderDecorative(obj)
    local p = obj.Parent
    local depth = 0
    while p and depth < 6 do
        if DECORATIVE_PARENTS[p.Name] then return true end
        p = p.Parent
        depth = depth + 1
    end
    return false
end

local function isPickupPumpkin(obj)
    if not obj.Parent then return false end
    if not PUMPKIN_CLASSES[obj.ClassName] then return false end -- cheaper than IsA x3
    local n = obj.Name
    if DECORATIVE_PARENTS[n] then return false end -- FIX: decorative models themselves were slipping through
    if not (n == "Pumpkin" or n == "Candy" or n:lower():find("pumpkin", 1, true)) then return false end
    if isUnderDecorative(obj) then return false end
    local top = obj
    while top.Parent and top.Parent ~= workspace do top = top.Parent end
    return top.Parent == workspace
end

-- remembers objects that already failed the check so we don't redo string ops on the whole workspace every scan
local rejectedPumpkin = setmetatable({}, weak)
local lastRejectClear = 0

local function considerPumpkin(obj, add)
    if rejectedPumpkin[obj] then return end
    if isPickupPumpkin(obj) then
        add(obj, PUMPKIN_LABEL, PUMPKIN_COLOR, "enabled")
    else
        rejectedPumpkin[obj] = true
    end
end

local updatePumpkins, resetPumpkins = makeESP(pumpkinFlags, 14, 1, function(add)
    local now = tick()
    if now - lastRejectClear > 10 then -- re-check occasionally in case something got reparented
        lastRejectClear = now
        for k in pairs(rejectedPumpkin) do rejectedPumpkin[k] = nil end
    end

    local kids = workspace:GetChildren()
    for i = 1, #kids do considerPumpkin(kids[i], add) end

    local q = workspace:FindFirstChild("Interactables")
    local quests = q and q:FindFirstChild("Quests")
    if quests then
        local qk = quests:GetChildren()
        for i = 1, #qk do
            if not DECORATIVE_PARENTS[qk[i].Name] then considerPumpkin(qk[i], add) end
        end
    end

    local qd = workspace:FindFirstChild("QuestDestination")
    if qd then
        local qdk = qd:GetChildren()
        for i = 1, #qdk do
            if not DECORATIVE_PARENTS[qdk[i].Name] then considerPumpkin(qdk[i], add) end
        end
    end
end)

