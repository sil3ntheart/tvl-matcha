local function createESP(player)
    if player == LocalPlayer or espObjects[player] then return end
    local obj = {
        name=newText(14),
        character=newText(14),
        items=newText(11),
        dist=newText(12),
    }
    if not obj.name or not obj.character or not obj.items or not obj.dist then
        if obj.name then safeRemove(obj.name) end
        if obj.character then safeRemove(obj.character) end
        if obj.items then safeRemove(obj.items) end
        if obj.dist then safeRemove(obj.dist) end
        return
    end
    setColor(obj.name, COLORS.name)
    setColor(obj.dist, COLORS.distance)
    setColor(obj.items, ITEM_COLOR)
    espObjects[player] = obj
    infoCache[player] = {
        username=player.Name, characterName=nil, species="?", color=SPECIES_COLORS["?"],
        display="[?]", itemsText="", char=nil, root=nil, hum=nil,
        lastDist=-1, distText="", lastRefresh=0, lastItemRefresh=0,
    }
    rebuildPlayerList()
end

local function hidePlayer(obj)
    if not obj then return end
    for _,d in pairs(obj) do if d then setVisible(d, false) end end
end
local function hideAllESP() for _,obj in pairs(espObjects) do hidePlayer(obj) end end
local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player]=nil
    infoCache[player]=nil
    rebuildPlayerList()
end

