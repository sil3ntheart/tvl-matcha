-- ============================================================
-- CONFIG
-- ============================================================
local CONFIG_FILE = "megs_tvl_config.json"

local function serialize(prefix, tbl, lines, allowNumbers)
    for k, v in pairs(tbl) do
        if k ~= "enabled" then
            if type(v) == "boolean" then
                lines[#lines+1] = prefix .. k .. "=B:" .. tostring(v)
            elseif allowNumbers and type(v) == "number" then
                lines[#lines+1] = prefix .. k .. "=N:" .. tostring(v)
            end
        end
    end
end

local function saveConfig()
    local lines = {}
    serialize("p_",  flags,      lines, true)
    serialize("pl_", plantFlags, lines, true)
    serialize("g_",  gemFlags,   lines, true)
    serialize("c_",  cureFlags,  lines, false)
    pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([BN]):(.+)$")
        if key and tag and val then
            local target, realKey = nil, key
            if key:sub(1, 2) == "p_" then
                target = flags; realKey = key:sub(3)
            elseif key:sub(1, 3) == "pl_" then
                target = plantFlags; realKey = key:sub(4)
            elseif key:sub(1, 2) == "g_" then
                target = gemFlags; realKey = key:sub(3)
            elseif key:sub(1, 2) == "c_" then
                target = cureFlags; realKey = key:sub(3)
            end
            if target then
                if tag == "B" then
                    target[realKey] = (val == "true")
                elseif tag == "N" then
                    target[realKey] = tonumber(val) or target[realKey]
                end
            end
        end
    end
end
pcall(loadConfig)

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

