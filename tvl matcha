local DRAW_COUNT = 0
local DRAW_CAP = 1800

local function safeNewText(size)
    if DRAW_COUNT >= DRAW_CAP then return nil end
    local ok, t = pcall(function() return Drawing.new("Text") end)
    if not ok or not t then return nil end
    DRAW_COUNT = DRAW_COUNT + 1
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Visible = false
    return t
end

local function safeRemove(d)
    if not d then return end
    pcall(function() d:Remove() end)
    DRAW_COUNT = DRAW_COUNT - 1
    if DRAW_COUNT < 0 then DRAW_COUNT = 0 end
end

local CONFIG_FILE = "megs_tvl_config.json"

local function serialize(prefix, tbl, lines, allowNumbers)
    for k, v in pairs(tbl) do
        if k ~= "enabled" then
            if type(v) == "boolean" then
                lines[#lines+1] = prefix .. k .. "=B:" .. tostring(v)
            elseif allowNumbers and type(v) == "number" then
                lines[#lines+1] = prefix .. k .. "=N:" .. tostring(v)
            end
        end
    end
end

local function saveConfig()
    local lines = {}
    serialize("p_", flags, lines, true)
    serialize("pl_", plantFlags, lines, true)
    serialize("g_", gemFlags, lines, true)
    serialize("c_", cureFlags, lines, false)
    local ok, err = pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
    if not ok then warn("[tvl] config save failed:", err) end
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\n]+") do
        local key, tag, val = line:match("^([^=]+)=([BN]):(.+)$")
        if key and tag and val then
            local target, realKey = nil, key
            if key:sub(1,2) == "p_" then target = flags; realKey = key:sub(3)
            elseif key:sub(1,3) == "pl_" then target = plantFlags; realKey = key:sub(4)
            elseif key:sub(1,2) == "g_" then target = gemFlags; realKey = key:sub(3)
            elseif key:sub(1,2) == "c_" then target = cureFlags; realKey = key:sub(3) end
            if target then
                if tag == "B" then target[realKey] = (val == "true")
                elseif tag == "N" then target[realKey] = tonumber(val) or target[realKey] end
            end
        end
    end
end

do
    local ok, err = pcall(loadConfig)
    if not ok then warn("[tvl] config load failed:", err) end
end

local savePending = false
local function scheduleSave()
    if savePending then return end
