-- ============================================================
-- SPECIES RESOLUTION (only called from the timed refresh)
-- ============================================================
local function getCharacterName(player)
    if not player then return nil end
    local ok, cname = pcall(function() return player:GetAttribute("CharacterName") end)
    if ok and cname and cname ~= "" then return cname end
    local ok2, dname = pcall(function() return player:GetAttribute("DisplayName") end)
    if ok2 and dname and dname ~= "" then return dname end
    return nil
end

local function getSpecies(player, character)
    if not character then return "?" end
    local ok, specType = pcall(function() return character:GetAttribute("SpecieType") end)
    if not ok then specType = nil end

    if specType and specType ~= "" then
        if specType == "Witch" then
            local cname = getCharacterName(player)
            if cname and SPECIAL_WITCHES[cname] then
                return SPECIAL_WITCHES[cname]
            end
            local ok2, isSiphoner = pcall(function() return character:GetAttribute("Siphoner") end)
            if ok2 and isSiphoner then return "Siphoner" end
        end
        return specType
    end

    local cname = getCharacterName(player)
    if cname and cname ~= "" then
        local sp = CHARACTER_SPECIES[cname]
        if sp then return sp end
        return "Custom"
    end
    return "?"
end

-- ============================================================
-- DRAWING HELPERS (write-only-on-change)
-- ============================================================
local COLORS = {
    name      = Color3.fromRGB(255, 255, 255),
    distance  = Color3.fromRGB(120, 255, 180),
}

local visCache   = setmetatable({}, { __mode = "k" })
local textCache  = setmetatable({}, { __mode = "k" })
local colorCache = setmetatable({}, { __mode = "k" })
local posX       = setmetatable({}, { __mode = "k" })
local posY       = setmetatable({}, { __mode = "k" })

local function setVisible(d, v)
    if visCache[d] ~= v then
        visCache[d] = v
        d.Visible = v
    end
end

local function setText(d, t)
    if textCache[d] ~= t then
        textCache[d] = t
        d.Text = t
    end
end

local function setColor(d, c)
    if colorCache[d] ~= c then
        colorCache[d] = c
        d.Color = c
    end
end

local function setPos(d, x, y)
    x = floor(x + 0.5)
    y = floor(y + 0.5)
    if posX[d] ~= x or posY[d] ~= y then
        posX[d] = x
        posY[d] = y
        d.Position = Vector2.new(x, y)
    end
end

local function newText(size)
    local t = Drawing.new("Text")
    t.Size = size or 14
    t.Center = true
    t.Outline = true
    t.Visible = false
    visCache[t] = false
    return t
end

local function removeAll(tbl)
    if not tbl then return end
    for _, d in pairs(tbl) do
        if d and d.Remove then pcall(function() d:Remove() end) end
    end
end

