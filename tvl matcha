local CONFIG_FILE = "megs_tvl_config.json"
local CONFIG_GROUPS = {
    { "p_",  flags },
    { "pl_", plantFlags },
    { "g_",  gemFlags },
    { "k_",  pumpkinFlags },
    { "b_",  bookFlags },
    { "m_",  mazeFlags },
    { "s_",  soulFlags },
    { "c_",  crowFlags },
}

local function saveConfig()
    local lines = {}
    for i = 1, #CONFIG_GROUPS do
        local prefix, tbl = CONFIG_GROUPS[i][1], CONFIG_GROUPS[i][2]
        for k, v in pairs(tbl) do
            if k ~= "enabled" then
                if type(v) == "boolean" then
                    lines[#lines+1] = prefix .. k .. "=B:" .. tostring(v)
                elseif type(v) == "number" then
                    lines[#lines+1] = prefix .. k .. "=N:" .. tostring(v)
                end
            end
        end
    end
    local ok, err = pcall(function() writefile(CONFIG_FILE, table.concat(lines, "\n")) end)
    if not ok then warn("[tvl] config save failed:", err) end
end

local function loadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not raw or raw == "" then return end
    for line in raw:gmatch("[^\r\n]+") do -- \r handled so Windows line endings don't break "true"
        local key, tag, val = line:match("^([^=]+)=([BN]):(.+)$")
        if key then
            for i = 1, #CONFIG_GROUPS do
                local prefix = CONFIG_GROUPS[i][1]
                if key:sub(1, #prefix) == prefix then
                    local target = CONFIG_GROUPS[i][2]
                    local realKey = key:sub(#prefix + 1)
                    local existing = target[realKey]
                    if realKey ~= "enabled" and existing ~= nil then
                        if tag == "B" and type(existing) == "boolean" then
                            target[realKey] = (val == "true")
                        elseif tag == "N" and type(existing) == "number" then
                            target[realKey] = tonumber(val) or existing
                        end
                    end
                    break
                end
            end
        end
    end
end

do
    local ok, err = pcall(loadConfig)
    if not ok then warn("[tvl] config load failed:", err) end
end

local savePending = false
local function scheduleSave()
    if savePending then return end
    savePending = true
    task.spawn(function()
        task.wait(0.4)
        savePending = false
        saveConfig()
    end)
end

