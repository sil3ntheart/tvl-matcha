local CURE_GREEN = Color3.fromRGB(0,255,80)
local CURE_RED = Color3.fromRGB(255,40,40)
local CURE_RANGE = 1836
local CURE_RANGE_SQ = CURE_RANGE * CURE_RANGE

local tombPosition = nil
local tombCheckTime = 0
local TOMB_RECHECK = 2
local lastKnownCureState = nil
local lastCureDraw = nil
local lastCureKey = nil
local lastCureCheck = 0
local CURE_INTERVAL = 0.25

local function getTombPos(box)
    if not box then return nil end
    local okP, pos = pcall(function() return box.Position end)
    if okP and pos and typeof(pos) == "Vector3" then return pos end
    if box:IsA("Model") then
        local prim = box.PrimaryPart
        if prim then
            local ok2, p2 = pcall(function() return prim.Position end)
            if ok2 and p2 then return p2 end
        end
    end
    local ok3, desc = pcall(function() return box:GetDescendants() end)
    if ok3 and desc then
        for _, d in ipairs(desc) do
            if d:IsA("BasePart") then
                local ok4, p4 = pcall(function() return d.Position end)
                if ok4 and p4 then return p4 end
            end
        end
    end
    return nil
end

local function locateTomb()
    local I = workspace:FindFirstChild("Interactables")
    if not I then return nil end
    local ST = I:FindFirstChild("SilasTomb")
    if not ST then return nil end
    local CB = ST:FindFirstChild("CureBox")
    if not CB then return nil end
    return getTombPos(CB)
end

local function getCureState()
    local now = tick()
    if not tombPosition or now - tombCheckTime >= TOMB_RECHECK then
        tombCheckTime = now
        local pos = locateTomb()
        if pos then tombPosition = pos end
    end
    if not tombPosition then return nil, nil end

    local I = workspace:FindFirstChild("Interactables")
    local ST = I and I:FindFirstChild("SilasTomb")
    local CB = ST and ST:FindFirstChild("CureBox")

    if not CB then return lastKnownCureState or "missing", tombPosition end
    if #CB:GetChildren() == 0 then return lastKnownCureState or "missing", tombPosition end

    local curePart = CB:FindFirstChild("TheCure", true)
                     or (ST and ST:FindFirstChild("TheCure", true))

    lastKnownCureState = (curePart and curePart.Parent) and "ground" or "missing"
    return lastKnownCureState, tombPosition
end

local function hideAllCure()
    if lastCureDraw then setVisible(lastCureDraw, false) end
end

local function updateCure(now, camPos)
    if now - lastCureCheck < CURE_INTERVAL then return end
    lastCureCheck = now

    local cureState, curePos = getCureState()
    local newKey = (cureState == "ground" or cureState == "missing") and cureState or nil

    if newKey ~= lastCureKey then
        if lastCureDraw then
            safeRemove(lastCureDraw)
            lastCureDraw = nil
        end
        lastCureKey = newKey
    end

    if not lastCureKey or not curePos then
        if lastCureDraw then
            safeRemove(lastCureDraw)
            lastCureDraw = nil
        end
        return
    end

    if not lastCureDraw then
        lastCureDraw = newText(18)
        if not lastCureDraw then return end
    end

    local dx = camPos.X - curePos.X
    local dy = camPos.Y - curePos.Y
    local dz = camPos.Z - curePos.Z
    if (dx*dx + dy*dy + dz*dz) > CURE_RANGE_SQ then
        setVisible(lastCureDraw, false)
        return
    end

    local label, color
    if lastCureKey == "ground" then
        label = "CURE AVAILABLE"
        color = CURE_GREEN
    else
        label = "CURE NOT AVAILABLE"
        color = CURE_RED
    end

    setColor(lastCureDraw, color)
    setText(lastCureDraw, label)
    local sp, on = WorldToScreen(curePos)
    if on and sp then
        setPos(lastCureDraw, sp.X, sp.Y - 30)
        setVisible(lastCureDraw, true)
    else
        setVisible(lastCureDraw, false)
    end
end

local resetPlantsGuard = 0
local resetGemsGuard = 0

local function renderLoop()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local camCF = camera.CFrame
    local camPos = camCF.Position
    local camLook = camCF.LookVector
    local now = tick()

    if flags.enabled then
        updatePlayersBatch(camPos, camLook, now, PLAYER_BATCH)
    end

    if plantFlags.enabled then
        local ok = pcall(updatePlants, camPos, camLook, WORLD_BATCH)
        if not ok and now - resetPlantsGuard > 5 then
            resetPlantsGuard = now
            resetPlants()
        end
    end

    if gemFlags.enabled then
        local ok = pcall(updateGems, camPos, camLook, WORLD_BATCH)
        if not ok and now - resetGemsGuard > 5 then
            resetGemsGuard = now
            resetGems()
        end
    end

    if cureFlags.enabled then pcall(updateCure, now, camPos) end
end

local renderOK = pcall(function() RunService.RenderStepped:Connect(renderLoop) end)
if not renderOK then
    task.spawn(function()
        while true do
            task.wait(1/60)
            pcall(renderLoop)
        end
    end)
end

