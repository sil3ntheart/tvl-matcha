local function createESP(player)
    if player == LocalPlayer or espObjects[player] then return end
    local obj = {
        name      = newText(14),
        character = newText(14),
        dist      = newText(12),
    }
    setColor(obj.name,  COLORS.name)
    setColor(obj.dist,  COLORS.distance)
    espObjects[player] = obj
    infoCache[player] = {
        username      = player.Name,
        characterName = nil,
        species       = "?",
        color         = SPECIES_COLORS["?"],
        display       = "[?]",
        char          = nil,
        root          = nil,
        hum           = nil,
        lastDist      = -1,
        distText      = "",
        lastRefresh   = 0,
    }
end

local function hidePlayer(obj)
    if not obj then return end
    for _, d in pairs(obj) do
        if d then setVisible(d, false) end
    end
end

local function hideAllESP()
    for _, obj in pairs(espObjects) do hidePlayer(obj) end
end

local function removeESP(player)
    if not espObjects[player] then return end
    removeAll(espObjects[player])
    espObjects[player] = nil
    infoCache[player] = nil
end

pcall(function()
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
end)
pcall(function()
    if Players.PlayerAdded then Players.PlayerAdded:Connect(createESP) end
end)
pcall(function()
    if Players.PlayerRemoving then Players.PlayerRemoving:Connect(removeESP) end
end)

-- safety net in case the events above don't fire in this executor
task.spawn(function()
    while true do
        task.wait(2)
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            local seen = {}
            for _, p in ipairs(list) do
                seen[p] = true
                if not espObjects[p] and p ~= LocalPlayer then createESP(p) end
            end
            for p in pairs(espObjects) do
                if not seen[p] then removeESP(p) end
            end
        end
    end
end)

-- Heavy lookups happen here, ~2x per second per player, never per frame.
local function refreshInfo(player, info, now)
    info.lastRefresh = now + INFO_REFRESH + math.random() * 0.15 -- staggered

    local char = player.Character
    info.char = char
    if char then
        info.root = char:FindFirstChild("HumanoidRootPart")
        info.hum  = char:FindFirstChildOfClass("Humanoid")
    else
        info.root, info.hum = nil, nil
    end

    info.characterName = getCharacterName(player) or info.characterName
    local species = getSpecies(player, char)
    info.species = species
    info.color = getColorForSpecies(species)

    local displayName = info.characterName
    if not displayName or displayName == "" then
        displayName = "[?]"
    end
    displayName = DISPLAY_ALIASES[displayName] or displayName
    if TRANSITIONING[species] then
        displayName = displayName .. " (transitioning)"
    end
    info.display = displayName
end

local function updatePlayers(camPos, now)
    local maxD      = flags.maxDist
    local showChar  = flags.character
    local showName  = flags.name
    local showDist  = flags.distance

    for player, obj in pairs(espObjects) do
        local info = infoCache[player]
        if info then
            if now >= info.lastRefresh then
                refreshInfo(player, info, now)
            end

            local visible = false
            local root, hum = info.root, info.hum

            if root and hum and root.Parent and hum.Health > 0 then
                local worldPos = root.Position
                local dist = (camPos - worldPos).Magnitude

                if dist <= maxD then
                    local sp, onScreen = WorldToScreen(worldPos)
                    if onScreen and sp then
                        visible = true

                        local x = sp.X
                        local y = sp.Y - clamp(1500 / max(dist, 1), 20, 250) * 0.5 - 18

                        if showChar then
                            local d = obj.character
                            setColor(d, info.color)
                            setText(d, info.display)
                            setPos(d, x, y)
                            setVisible(d, true)
                            y = y + 16
                        else
                            setVisible(obj.character, false)
                        end

                        if showName then
                            local d = obj.name
                            setText(d, info.username)
                            setPos(d, x, y)
                            setVisible(d, true)
                            y = y + 15
                        else
                            setVisible(obj.name, false)
                        end

                        if showDist then
                            local fd = floor(dist)
                            if fd ~= info.lastDist then
                                info.lastDist = fd
                                info.distText = fd .. " studs"
                            end
                            local d = obj.dist
                            setText(d, info.distText)
                            setPos(d, x, y)
                            setVisible(d, true)
                        else
                            setVisible(obj.dist, false)
                        end
                    end
                end
            end

            if not visible then hidePlayer(obj) end
        end
    end
end

-- ============================================================
-- WORLD ESP (plants + gems): cached, throttled scan
-- ============================================================
local SCAN_INTERVAL = 1

local function findPart(model)
    if BASE_CLASSES[model.ClassName] then return model end
    local ok, part = pcall(function()
        return model:FindFirstChildWhichIsA("BasePart", true)
    end)
    if ok and part then return part end
    -- fallback, runs only when a model is first discovered
    for _, d in ipairs(model:GetDescendants()) do
        if BASE_CLASSES[d.ClassName] then return d end
    end
    return nil
end

local function getInteractableFolder(name)
    return function()
        local i = workspace:FindFirstChild("Interactables")
        return i and i:FindFirstChild(name)
    end
end

local function makeWorldESP(getContainer, resolve, f, textColor)
    local entries = {}
    local lastScan = -math.huge

    local function scan(now)
        lastScan = now
        local container = getContainer()
        local seen = {}

        if container then
            for _, m in ipairs(container:GetChildren()) do
                seen[m] = true
                local e = entries[m]
                if not e then
                    local label, flag = resolve(m.Name)
                    if label then
                        local part = findPart(m)
                        if part then
                            entries[m] = {
                                part = part, label = label, flag = flag,
                                draw = nil, key = nil, text = nil,
                            }
                        end
                    end
                elseif not e.part.Parent then
                    -- cached part vanished, find a new one
                    local part = findPart(m)
                    if part then
                        e.part = part
                    else
                        seen[m] = nil
                    end
                end
            end
        end

        for m, e in pairs(entries) do
            if not seen[m] then
                if e.draw then pcall(function() e.draw:Remove() end) end
                entries[m] = nil
            end
        end
    end

    local function update(camPos)
        local now = tick()
        if now - lastScan >= SCAN_INTERVAL then scan(now) end

        local maxD = f.maxDist
        local showDist = f.showDist

        for _, e in pairs(entries) do
            local draw = e.draw
            local show = false

            if f[e.flag] then
                local pos = e.part.Position
                if pos then
                    local dist = (camPos - pos).Magnitude
                    if dist <= maxD then
                        local sp, on = WorldToScreen(pos)
                        if on and sp then
                            if not draw then
                                draw = newText(13)
                                setColor(draw, textColor)
                                e.draw = draw
                            end

                            local key = showDist and floor(dist) or -1
                            if key ~= e.key then
                                e.key = key
                                e.text = showDist and (e.label .. " [" .. key .. "]") or e.label
                            end
                            setText(draw, e.text)
                            setPos(draw, sp.X, sp.Y)
                            setVisible(draw, true)
                            show = true
                        end
                    end
                end
            end

            if not show and draw then
                setVisible(draw, false)
            end
        end
    end

    local function hide()
        for _, e in pairs(entries) do
            if e.draw then setVisible(e.draw, false) end
        end
    end

    -- lets us wipe the cache if a scan ever needs to be forced
    local function reset()
        lastScan = -math.huge
    end

    return update, hide, reset
end

local updatePlants, hideAllPlants, resetPlants = makeWorldESP(
